{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "outDir": "dist/esm",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts"]
}
