<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ansight.Tools.Preferences</AssemblyName>
    <RootNamespace>Ansight.Tools.Preferences</RootNamespace>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Ansight.Tools.Preferences</PackageId>
    <PackageVersion>0.3.0</PackageVersion>
    <Authors>Ansight AI</Authors>
    <Company>Ansight AI</Company>
    <Product>Ansight</Product>
    <Description>Shared preferences and user-defaults remote tools for the Ansight .NET SDK.</Description>
    <PackageProjectUrl>https://github.com/ansight-ai/ansight-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ansight-ai/ansight-sdk</RepositoryUrl>
    <PackageTags>ansight;tools;preferences;sharedpreferences;nsuserdefaults;storage</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight\Ansight.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
