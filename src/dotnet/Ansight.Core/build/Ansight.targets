<Project>
  <PropertyGroup>
    <_AnsightRemoteToolsPolicySpecified Condition="'$(AnsightRemoteToolsPolicy)' != ''">true</_AnsightRemoteToolsPolicySpecified>
    <_AnsightAllowRemoteToolsNormalized Condition="'$(AnsightAllowRemoteTools)' != ''">$([System.String]::Copy('$(AnsightAllowRemoteTools)').ToLowerInvariant())</_AnsightAllowRemoteToolsNormalized>
    <AnsightRemoteToolsPolicy Condition="'$(AnsightRemoteToolsPolicy)' == '' and '$(_AnsightAllowRemoteToolsNormalized)' == 'true'">Allowed</AnsightRemoteToolsPolicy>
    <AnsightRemoteToolsPolicy Condition="'$(AnsightRemoteToolsPolicy)' == '' and '$(_AnsightAllowRemoteToolsNormalized)' == 'false'">Disallowed</AnsightRemoteToolsPolicy>
    <AnsightRemoteToolsPolicy Condition="'$(AnsightRemoteToolsPolicy)' == ''">AllowedWithWarnings</AnsightRemoteToolsPolicy>
    <AnsightLogRemoteTools Condition="'$(AnsightLogRemoteTools)' == ''">true</AnsightLogRemoteTools>
    <_AnsightRemoteToolsPolicyNormalized>$([System.String]::Copy('$(AnsightRemoteToolsPolicy)').ToLowerInvariant())</_AnsightRemoteToolsPolicyNormalized>
    <_AnsightLogRemoteToolsNormalized>$([System.String]::Copy('$(AnsightLogRemoteTools)').ToLowerInvariant())</_AnsightLogRemoteToolsNormalized>
    <AnsightRemoteToolsEnabled Condition="'$(_AnsightRemoteToolsPolicyNormalized)' == 'allowed' or '$(_AnsightRemoteToolsPolicyNormalized)' == 'allowedwithwarnings'">true</AnsightRemoteToolsEnabled>
    <AnsightRemoteToolsEnabled Condition="'$(_AnsightRemoteToolsPolicyNormalized)' != 'allowed' and '$(_AnsightRemoteToolsPolicyNormalized)' != 'allowedwithwarnings'">false</AnsightRemoteToolsEnabled>
    <_AnsightDefineConstantsContainsRemoteTools>$([System.String]::Copy(';$(DefineConstants);').Contains(';ANSIGHT_REMOTE_TOOLS;'))</_AnsightDefineConstantsContainsRemoteTools>
    <DefineConstants Condition="'$(AnsightRemoteToolsEnabled)' == 'true' and '$(DefineConstants)' == ''">ANSIGHT_REMOTE_TOOLS</DefineConstants>
    <DefineConstants Condition="'$(AnsightRemoteToolsEnabled)' == 'true' and '$(DefineConstants)' != '' and '$(_AnsightDefineConstantsContainsRemoteTools)' != 'true'">$(DefineConstants);ANSIGHT_REMOTE_TOOLS</DefineConstants>
    <_AnsightBuildTaskAssemblyPackagePath>$(MSBuildThisFileDirectory)Ansight.Build.dll</_AnsightBuildTaskAssemblyPackagePath>
    <_AnsightBuildTaskAssemblySourcePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Ansight.Build.dll'))</_AnsightBuildTaskAssemblySourcePath>
    <_AnsightBuildTaskAssemblyPath>$(_AnsightBuildTaskAssemblyPackagePath)</_AnsightBuildTaskAssemblyPath>
    <_AnsightBuildTaskAssemblyPath Condition="!Exists('$(_AnsightBuildTaskAssemblyPackagePath)') and Exists('$(_AnsightBuildTaskAssemblySourcePath)')">$(_AnsightBuildTaskAssemblySourcePath)</_AnsightBuildTaskAssemblyPath>
  </PropertyGroup>

  <UsingTask TaskName="Ansight.Build.Tasks.ScanForAnsightToolImplementations"
             AssemblyFile="$(_AnsightBuildTaskAssemblyPath)"
             Runtime="NET" />

  <Target Name="AddAnsightRemoteToolsDefineConstant"
          BeforeTargets="CoreCompile"
          Condition="'$(AnsightRemoteToolsEnabled)' == 'true'">
    <PropertyGroup>
      <_AnsightDefineConstantsWasEmpty Condition="'$(DefineConstants)' == ''">true</_AnsightDefineConstantsWasEmpty>
    </PropertyGroup>

    <ItemGroup>
      <_AnsightExistingDefineConstant Include="$(DefineConstants)" />
      <_AnsightRemoteToolsDefineConstant Include="ANSIGHT_REMOTE_TOOLS"
                                         Exclude="@(_AnsightExistingDefineConstant)" />
    </ItemGroup>

    <PropertyGroup Condition="'@(_AnsightRemoteToolsDefineConstant)' != ''">
      <DefineConstants Condition="'$(_AnsightDefineConstantsWasEmpty)' == 'true'">@(_AnsightRemoteToolsDefineConstant)</DefineConstants>
      <DefineConstants Condition="'$(_AnsightDefineConstantsWasEmpty)' != 'true'">$(DefineConstants);@(_AnsightRemoteToolsDefineConstant)</DefineConstants>
    </PropertyGroup>
  </Target>

  <Target Name="ValidateAnsightRemoteToolPolicy"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Error Condition="'$(_AnsightRemoteToolsPolicySpecified)' != 'true' and '$(AnsightAllowRemoteTools)' != '' and '$(_AnsightAllowRemoteToolsNormalized)' != 'true' and '$(_AnsightAllowRemoteToolsNormalized)' != 'false'"
           Text="AnsightAllowRemoteTools has been replaced by AnsightRemoteToolsPolicy. Legacy compatibility only accepts 'true' or 'false'." />
    <Error Condition="'$(_AnsightRemoteToolsPolicyNormalized)' != 'allowed' and '$(_AnsightRemoteToolsPolicyNormalized)' != 'allowedwithwarnings' and '$(_AnsightRemoteToolsPolicyNormalized)' != 'disallowed'"
           Text="AnsightRemoteToolsPolicy must be one of 'Allowed', 'AllowedWithWarnings', or 'Disallowed'." />
    <Error Condition="'$(_AnsightLogRemoteToolsNormalized)' != 'true' and '$(_AnsightLogRemoteToolsNormalized)' != 'false'"
           Text="AnsightLogRemoteTools must be either 'true' or 'false'." />
  </Target>

  <Target Name="CheckAnsightToolImplementations"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(_AnsightRemoteToolsPolicyNormalized)' != 'allowed' and Exists('$(TargetDir)')">
    <Error Condition="!Exists('$(_AnsightBuildTaskAssemblyPath)')"
           Text="Ansight remote tool enforcement is enabled, but the Ansight build task assembly was not found. Expected one of: '$(_AnsightBuildTaskAssemblyPackagePath)' or '$(_AnsightBuildTaskAssemblySourcePath)'." />
    <ItemGroup>
      <_AnsightToolResolverAssembly Include="@(ReferencePath)" />
      <_AnsightToolResolverAssembly Include="@(ReferenceCopyLocalPaths)" />
      <_AnsightToolResolverAssembly Include="$(TargetPath)" Condition="'$(TargetPath)' != '' and Exists('$(TargetPath)')" />
    </ItemGroup>

    <Ansight.Build.Tasks.ScanForAnsightToolImplementations OutputDirectory="$(TargetDir)"
                                                           ResolverAssemblyPaths="@(_AnsightToolResolverAssembly)">
      <Output TaskParameter="DetectedTools" ItemName="_AnsightDetectedTool" />
    </Ansight.Build.Tasks.ScanForAnsightToolImplementations>

    <PropertyGroup Condition="'@(_AnsightDetectedTool)' != ''">
      <_AnsightDetectedToolList>@(_AnsightDetectedTool-&gt;'  - %(Identity) (%(AssemblyName))', '&#x0A;')</_AnsightDetectedToolList>
    </PropertyGroup>

    <Warning Condition="'@(_AnsightDetectedTool)' != '' and '$(_AnsightRemoteToolsPolicyNormalized)' == 'allowedwithwarnings' and '$(_AnsightLogRemoteToolsNormalized)' == 'true'"
             Text="Ansight remote tools are included in this build:&#x0A;$(_AnsightDetectedToolList)&#x0A;AnsightRemoteToolsPolicy=AllowedWithWarnings allows the build to continue. Set AnsightRemoteToolsPolicy=Disallowed to fail builds that include remote tools, or Allowed to bypass remote tool scanning and warnings." />
    <Warning Condition="'@(_AnsightDetectedTool)' != '' and '$(_AnsightRemoteToolsPolicyNormalized)' == 'allowedwithwarnings' and '$(_AnsightLogRemoteToolsNormalized)' == 'false'"
             Text="Ansight remote tools are included in this build. AnsightRemoteToolsPolicy=AllowedWithWarnings allows the build to continue. Set AnsightLogRemoteTools=true to log detected tool types and assemblies. Set AnsightRemoteToolsPolicy=Disallowed to fail builds that include remote tools, or Allowed to bypass remote tool scanning and warnings." />
    <Error Condition="'@(_AnsightDetectedTool)' != '' and '$(_AnsightRemoteToolsPolicyNormalized)' == 'disallowed' and '$(_AnsightLogRemoteToolsNormalized)' == 'true'"
           Text="Ansight blocked remote tools in this build because AnsightRemoteToolsPolicy=Disallowed. Detected tool implementations:&#x0A;$(_AnsightDetectedToolList)&#x0A;Fix: remove the tool package/reference from this build, or make it Debug-only with MSBuild conditions. For local debugging builds, set AnsightRemoteToolsPolicy=AllowedWithWarnings to allow with build warnings. Security guidance: never allow remote tools in non-Debug or shippable builds, because they add remote inspection and execution capabilities that can expose user data, filesystem/database contents, screenshots, UI state, and other privileged app behavior to a connected client." />
    <Error Condition="'@(_AnsightDetectedTool)' != '' and '$(_AnsightRemoteToolsPolicyNormalized)' == 'disallowed' and '$(_AnsightLogRemoteToolsNormalized)' == 'false'"
           Text="Ansight blocked remote tools in this build because AnsightRemoteToolsPolicy=Disallowed. Set AnsightLogRemoteTools=true to log detected tool types and assemblies. Fix: remove the tool package/reference from this build, or make it Debug-only with MSBuild conditions. For local debugging builds, set AnsightRemoteToolsPolicy=AllowedWithWarnings to allow with build warnings. Security guidance: never allow remote tools in non-Debug or shippable builds, because they add remote inspection and execution capabilities that can expose user data, filesystem/database contents, screenshots, UI state, and other privileged app behavior to a connected client." />
  </Target>
</Project>
