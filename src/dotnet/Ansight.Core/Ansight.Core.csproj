<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android35.0;net9.0-ios18.0;net9.0-maccatalyst18.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Ansight.Core</AssemblyName>
    <RootNamespace>Ansight</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Ansight.Core</PackageId>
    <Description>Core telemetry, pairing, and remote tool infrastructure for .NET Android, iOS, and Mac Catalyst apps.</Description>
    <PackageTags>observability;memory;metrics;debugging;fps;telemetry;mobile;android;ios;mac;maccatalyst;performance</PackageTags>
    <NoWarn>$(NoWarn);NU5110;NU5111;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight.Build\Ansight.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers" />
    <None Include="build\Ansight.targets" Pack="true" PackagePath="buildTransitive\Ansight.Core.targets" />
    <None Include="..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Ansight.Build.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Mono.Cecil.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="build\generate-ansight-developer-pairing.sh" Pack="true" PackagePath="buildTransitive\generate-ansight-developer-pairing.sh" />
    <None Include="build\generate-ansight-developer-pairing.ps1" Pack="true" PackagePath="buildTransitive\generate-ansight-developer-pairing.ps1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android35.0'">
    <PackageReference Include="Xamarin.AndroidX.Security.SecurityCrypto" Version="1.1.0.4-alpha07" />
  </ItemGroup>

</Project>
