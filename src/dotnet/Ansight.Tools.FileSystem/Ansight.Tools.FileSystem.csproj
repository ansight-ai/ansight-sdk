<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ansight.Tools.FileSystem</AssemblyName>
    <RootNamespace>Ansight.Tools.FileSystem</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Ansight.Tools.FileSystem</PackageId>
    <Description>Sandboxed file browsing and download remote tools for the Ansight .NET SDK.</Description>
    <PackageTags>ansight;tools;filesystem;files;inspection;sandbox</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight\Ansight.csproj" />
  </ItemGroup>

</Project>
