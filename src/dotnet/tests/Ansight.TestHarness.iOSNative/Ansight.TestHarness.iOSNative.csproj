<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <AssemblyName>Ansight.TestHarness.iOSNative</AssemblyName>
    <ApplicationId>com.example.ansight.iosharness</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ansight.Core\Ansight.Core.csproj" />
    <!-- Intentionally direct: this harness reads binding state to verify Core selected the native runtime. -->
    <ProjectReference Include="..\..\Ansight.Native.Apple.Binding\Ansight.Native.Apple.Binding.csproj" />
    <Compile Include="..\NativeBindingDiagnostics.cs" Link="NativeBindingDiagnostics.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

</Project>
