<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Ansight</AssemblyName>
    <RootNamespace>Ansight</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Ansight</PackageId>
    <Description>All-in-one Ansight SDK package for .NET apps, including core runtime, pairing, and remote tools.</Description>
    <PackageTags>ansight;observability;debugging;telemetry;pairing;remote-tools;android;ios;maccatalyst</PackageTags>
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight.Core\Ansight.Core.csproj" />
    <ProjectReference Include="..\Ansight.OfflineCapture\Ansight.OfflineCapture.csproj" />
    <ProjectReference Include="..\Ansight.Tools.Database\Ansight.Tools.Database.csproj" />
    <ProjectReference Include="..\Ansight.Tools.FileSystem\Ansight.Tools.FileSystem.csproj" />
    <ProjectReference Include="..\Ansight.Tools.Preferences\Ansight.Tools.Preferences.csproj" />
    <ProjectReference Include="..\Ansight.Tools.Reflection\Ansight.Tools.Reflection.csproj" />
    <ProjectReference Include="..\Ansight.Tools.SecureStorage\Ansight.Tools.SecureStorage.csproj" />
    <ProjectReference Include="..\Ansight.Tools.VisualTree\Ansight.Tools.VisualTree.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <ProjectReference Include="..\Ansight.Pairing\Ansight.Pairing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight.Build\Ansight.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers" />
    <None Include="..\Ansight.Core\build\Ansight.targets" Pack="true" PackagePath="buildTransitive\Ansight.targets" />
    <None Include="..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Ansight.Build.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Mono.Cecil.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="..\Ansight.Core\build\generate-ansight-developer-pairing.sh" Pack="true" PackagePath="buildTransitive\generate-ansight-developer-pairing.sh" />
    <None Include="..\Ansight.Core\build\generate-ansight-developer-pairing.ps1" Pack="true" PackagePath="buildTransitive\generate-ansight-developer-pairing.ps1" />
  </ItemGroup>

</Project>
