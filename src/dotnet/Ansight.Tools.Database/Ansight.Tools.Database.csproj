<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ansight.Tools.Database</AssemblyName>
    <RootNamespace>Ansight.Tools.Database</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Ansight.Tools.Database</PackageId>
    <Description>Database discovery, schema inspection, and read-only query tools for the Ansight .NET SDK.</Description>
    <PackageTags>ansight;tools;database;sqlite;sql;inspection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight\Ansight.csproj" />
  </ItemGroup>

</Project>
