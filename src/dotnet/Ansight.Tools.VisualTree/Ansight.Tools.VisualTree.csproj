<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ansight.Tools.VisualTree</AssemblyName>
    <RootNamespace>Ansight.Tools.VisualTree</RootNamespace>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Ansight.Tools.VisualTree</PackageId>
    <Description>Visual tree inspection and screenshot remote tools for the Ansight .NET SDK.</Description>
    <PackageTags>ansight;tools;visual-tree;screenshot;ui;inspection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight\Ansight.csproj" />
  </ItemGroup>

</Project>
