<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ansight.Maui</AssemblyName>
    <RootNamespace>Ansight.Maui</RootNamespace>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Ansight.Maui</PackageId>
    <PackageVersion>0.3.0</PackageVersion>
    <Authors>Ansight AI</Authors>
    <Company>Ansight AI</Company>
    <Product>Ansight.Maui</Product>
    <Description>MAUI helpers for Ansight host pairing asset wiring and payload readers.</Description>
    <PackageProjectUrl>https://github.com/ansight-ai/ansight-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ansight-ai/ansight-sdk</RepositoryUrl>
    <PackageTags>ansight;maui;pairing;diagnostics;mobile</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight\Ansight.csproj" />
  </ItemGroup>

</Project>
