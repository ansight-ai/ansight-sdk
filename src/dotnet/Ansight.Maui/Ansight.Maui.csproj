<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Ansight.Maui</AssemblyName>
    <RootNamespace>Ansight.Maui</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Ansight.Maui</PackageId>
    <Description>All-in-one Ansight SDK package for .NET MAUI apps, including core runtime, pairing, remote tools, automatic lifecycle and page-view telemetry, and MAUI inspection tools.</Description>
    <PackageTags>ansight;maui;observability;debugging;telemetry;pairing;remote-tools;android;ios;maccatalyst</PackageTags>
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <UseMaui>true</UseMaui>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight\Ansight.csproj" />
    <ProjectReference Include="..\Ansight.OfflineCapture\Ansight.OfflineCapture.csproj" />
    <ProjectReference Include="..\Ansight.Tools.Maui\Ansight.Tools.Maui.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ansight.Build\Ansight.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers" />
    <None Include="..\Ansight.Core\build\Ansight.targets" Pack="true" PackagePath="buildTransitive\Ansight.Maui.targets" />
    <None Include="..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Ansight.Build.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="..\Ansight.Build\bin\$(Configuration)\netstandard2.0\Mono.Cecil.dll"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
    <None Include="..\Ansight.Core\build\generate-ansight-developer-pairing.sh" Pack="true" PackagePath="buildTransitive\generate-ansight-developer-pairing.sh" />
    <None Include="..\Ansight.Core\build\generate-ansight-developer-pairing.ps1" Pack="true" PackagePath="buildTransitive\generate-ansight-developer-pairing.ps1" />
  </ItemGroup>

</Project>
